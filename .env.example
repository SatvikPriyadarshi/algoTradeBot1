# ========================================================
# QUANT ALGO ENGINE — copy to .env and edit
# ========================================================
# python engine.py --port 5076 --mode live

ENGINE_PORT=5076
ENGINE_MODE=live
ENGINE_TIMEFRAME=M15

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo

STRATEGY=opt_mean_rev

RISK_PER_TRADE=50
MAX_DAILY_LOSS=500
MAX_TRADES_PER_DAY=0
MAX_CONCURRENT_TRADES=7

BACKTEST_TRADE_CAPITAL=500
BACKTEST_LEVERAGE=100

OPT_MAX_HOLD_BARS=20
SCAN_LOG_INTERVAL=60

COMMISSION_PER_LOT=7.0
SLIPPAGE_TICKS=2.0

SYMBOLS=GBPUSD,AUDUSD,EURUSD,USDCAD,USDCHF,XAUUSD
